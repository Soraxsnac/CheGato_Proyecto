<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CheGato.App.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <!-- Corrección: SemanticProperties sin 's' -->
            <Label Text="Inventario Che Gato" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />

            <Button x:Name="CargarBtn" Text="Cargar Productos" Clicked="OnCargarClicked" />

            <CollectionView x:Name="ListaProductos">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Corrección: Usamos Border en lugar de Frame -->
                        <Border Margin="0,5" Padding="10" BackgroundColor="#2B0B98">
                            <VerticalStackLayout>
                                <Label Text="{Binding Nombre}" FontSize="18" TextColor="White" FontAttributes="Bold" />
                                <Label Text="{Binding Precio, StringFormat='${0:F2}'}" FontSize="14" TextColor="LightGray" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>